POWERSHIFT_MODE=demo
EARTH_ENGINE_PROJECT=
# Optional service account; otherwise use earthengine authenticate.
GOOGLE_APPLICATION_CREDENTIALS=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Set a deployed Elastic text embedding inference endpoint for semantic_text.
ELASTIC_INFERENCE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Local, regional GeoJSON files in WGS84 (EPSG:4326).
HIFLD_GEOJSON=data/private/transmission.geojson
PADUS_GEOJSON=data/private/protected.geojson
HIFLD_VINTAGE=2022-10-24
PADUS_VINTAGE=4.1
CACHE_DIR=.cache
# Optional wind residual model; never trains during web requests.
VOLRIDGE_ML_ENABLED=false
VOLRIDGE_ML_DATA_DIR=data/private/ml

# Nationwide city screening (indexed from the original national downloads).
HIFLD_NATIONAL=data/private/national/transmission.gpkg
PADUS_NATIONAL=data/private/source/PADUS4_1Geodatabase.gdb
